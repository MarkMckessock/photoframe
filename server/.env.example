# Twilio. All three are required; the service refuses to start without them.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Must match the URL Twilio is configured to POST to, exactly -- the signature is
# computed over it, so a trailing slash or the wrong scheme means every request 403s.
TWILIO_WEBHOOK_URL=https://photoframe.markmckessock.com/mms

# Where the rendered blob lives. Needs to be a volume that survives a restart.
STORE_DIR=/data

# Empty ALLOWED_NUMBERS means anyone who knows the number can send a photo.
ALLOWED_NUMBERS=
ADMIN_NUMBERS=+15555550100
RATE_LIMIT=10 per minute; 50 per hour

# Image pipeline. IMAGE_CROP=false letterboxes onto white, which beats cropping
# somebody out of a group photo.
PANEL_WIDTH=1200
PANEL_HEIGHT=1600
IMAGE_CROP=false
IMAGE_SATURATION=1.4
IMAGE_CONTRAST=1.0
IMAGE_PALETTE=measured
MAX_MEDIA_BYTES=8388608
DELETE_TWILIO_MEDIA=true

# Only used for admin commands (/status, /refresh). The frame never learns about
# images over MQTT -- it polls /latest.pfrm.
MQTT_HOST=mosquitto.home-automation.svc.cluster.local
MQTT_PORT=1883
MQTT_TOPIC_ROOT=home/photoframe
