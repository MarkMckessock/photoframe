// Rename this file to secrets.h and fill it in. secrets.h is gitignored.
//
// This mirrors the splitflap firmware's secrets.h.example so the two projects feel
// like the same codebase, with IMAGE_URL added.

// --- Network -------------------------------------------------------------
#define WIFI_SSID     "myssid"
#define WIFI_PASSWORD "supersecretpassword"

// Hostname for this device. Also used for MDNS ("photoframe" -> photoframe.local),
// for the MQTT client id, and as the root of every MQTT topic. If you change it,
// update upload_port in the [env:photoframe_ota] section of platformio.ini to match.
#define DEVICE_INSTANCE_NAME "photoframe"

// --- Image source --------------------------------------------------------
// Where the pre-rendered .pfrm blob lives. This should be a LAN-only address --
// the photoframe-webhook service gets a second, internal-only Service for exactly
// this, the same way mosquitto has one. Do not point this at a public route; the
// photos your friends send should not leave the network.
//
// For bench testing, point it at tools/serve_test.py on your laptop.
#define IMAGE_URL "http://10.0.70.132/latest.pfrm"

// --- MQTT (control plane only: state, availability, commands) ------------
#define MQTT_SERVER   "10.0.70.131"
#define MQTT_PORT     (1883)
// The cluster broker runs allow_anonymous. Leave these empty to connect anonymously.
#define MQTT_USER     ""
#define MQTT_PASSWORD ""

// --- OTA -----------------------------------------------------------------
// Password for the button-triggered ArduinoOTA maintenance window. Note that this
// device is asleep almost all the time, so this is the *hands-on* path only; routine
// updates go through the retained home/<device>/cmd/ota topic instead.
//
// To use it: hold button 3 for 5 seconds, then upload with the photoframe_ota env.
#define OTA_PASSWORD "replace_me!"
